# ============================================
# Mastercard API Tester - Configuração
# ============================================
# Copie este ficheiro para .env e preencha com os seus dados:
#   cp .env.example .env
#
# Os dados são obtidos no Mastercard Developers Portal:
#   https://developer.mastercard.com/

# ============================================
# OAuth 1.0a - Credenciais de Assinatura
# ============================================

# Consumer Key (obtida no Mastercard Developer Portal, na secção do seu projeto)
CONSUMER_KEY=

# Caminho para o ficheiro PKCS#12 da chave privada de assinatura
# (downloaded do Mastercard Developer Portal como "Signing Key")
SIGNING_KEY_PATH=./keys/signing-key.p12

# Alias da chave dentro do PKCS#12 (geralmente "keyalias" ou "clientkey")
SIGNING_KEY_ALIAS=keyalias

# Password do ficheiro PKCS#12 de assinatura
SIGNING_KEY_PASSWORD=

# ============================================
# JWE - Encriptação/Desencriptação de Payload
# ============================================

# Caminho para o certificado público de encriptação (PEM)
# (fornecido pelo Mastercard como "Client Encryption Key")
ENCRYPTION_CERT_PATH=./keys/client-encryption.pem

# Caminho para a chave privada de desencriptação (PKCS#12)
# (downloaded do Mastercard Developer Portal como "Mastercard Encryption Key")
DECRYPTION_KEY_PATH=./keys/decryption-key.p12

# Alias da chave de desencriptação dentro do PKCS#12
DECRYPTION_KEY_ALIAS=keyalias

# Password do ficheiro PKCS#12 de desencriptação
DECRYPTION_KEY_PASSWORD=

# ============================================
# API Configuration
# ============================================

# URL base da API (sandbox ou produção)
API_BASE_URL=https://sandbox.api.mastercard.com

# Porta do servidor backend
PORT=3001
