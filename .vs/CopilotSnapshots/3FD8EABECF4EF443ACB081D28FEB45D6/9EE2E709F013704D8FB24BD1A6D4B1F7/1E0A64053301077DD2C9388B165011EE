foreach (var route in proxyRoutes)
{
    var template = route.Template;
    var method = route.Method;
    var routeName = $"Proxy_{method.Method}_{template}"
        .Replace('/', '_').Replace('{', '_').Replace('}', '_').Replace('-', '_');
    var hasBody = method != HttpMethod.Get && method != HttpMethod.Delete;

    api.MapMethods(template, [method.Method], async (HttpContext httpContext, IProcessingCoreClient client, CancellationToken cancellationToken) =>
        {
            var downstreamPath = BuildDownstreamPath(httpContext, template);
            JsonElement? body = hasBody
                ? await ReadBodyAsync(httpContext, cancellationToken)
                : null;

            var result = await client.SendAsync(method, downstreamPath, body, cancellationToken);
            return result is null ? Results.NoContent() : Results.Ok(result.Value);
        })
        .WithName(routeName)
        .WithSummary($"{method.Method} {template} (generic pass-through to Mastercard Processing Core)")
        .WithTags("Mastercard Processing Core (Proxy)")
        .Accepts(typeof(object), hasBody, "application/json")
        .WithOpenApi(operation =>
        {
            foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(template, "{([^}]+)}"))
            {
                operation.Parameters.Add(new Microsoft.OpenApi.OpenApiParameter
                {
                    Name = match.Groups[1].Value,
                    In = Microsoft.OpenApi.ParameterLocation.Path,
                    Required = true,
                    Schema = new Microsoft.OpenApi.OpenApiSchema { Type = Microsoft.OpenApi.JsonSchemaType.String }
                });
            }

            if (hasBody)
            {
                operation.RequestBody = new Microsoft.OpenApi.OpenApiRequestBody
                {
                    Required = false,
                    Content = new Dictionary<string, Microsoft.OpenApi.OpenApiMediaType>
                    {
                        ["application/json"] = new Microsoft.OpenApi.OpenApiMediaType
                        {
                            Schema = new Microsoft.OpenApi.OpenApiSchema { Type = Microsoft.OpenApi.JsonSchemaType.Object, AdditionalPropertiesAllowed = true }
                        }
                    }
                };
            }

            return operation;
        });
}

app.Run();

static string BuildDownstreamPath(HttpContext context, string template)
{
    var path = template.TrimStart('/');
    foreach (var (key, value) in context.Request.RouteValues)
    {
        path = path.Replace($"{{{key}}}", Uri.EscapeDataString(value?.ToString() ?? string.Empty));
    }

    if (context.Request.QueryString.HasValue)
    {
        path += context.Request.QueryString.Value;
    }

    return path;
}

static async Task<JsonElement?> ReadBodyAsync(HttpContext context, CancellationToken cancellationToken)
{
    if (context.Request.ContentLength is null or 0)
    {
        return null;
    }

    using var doc = await JsonDocument.ParseAsync(context.Request.Body, cancellationToken: cancellationToken);
    return doc.RootElement.Clone();
}

