    (HttpMethod.Get, "/accounts/{account_contract_id}/sub-accounts"),
    (HttpMethod.Get, "/accounts/{account_contract_id}/card-contracts"),
    (HttpMethod.Post, "/cards"),
    (HttpMethod.Get, "/cards/{card_contract_id}"),
    (HttpMethod.Patch, "/cards/{card_contract_id}"),
    (HttpMethod.Post, "/cards/details-verifications"),
    (HttpMethod.Put, "/cards/{card_contract_id}/status"),
    (HttpMethod.Get, "/cards/{card_contract_id}/statuses"),
    (HttpMethod.Put, "/cards/{card_contract_id}/client-identifier"),
    (HttpMethod.Put, "/cards/{card_contract_id}/main-contract"),
    (HttpMethod.Put, "/cards/{card_contract_id}/online-pin-attempts-counter"),
    (HttpMethod.Put, "/clients/{client_id}/online-pin-attempts-counter"),
    (HttpMethod.Put, "/cards/{card_contract_id}/active"),
    (HttpMethod.Put, "/cards/{card_contract_id}/pin"),
    (HttpMethod.Post, "/cards/{card_contract_id}/pins/searches"),
    (HttpMethod.Post, "/cards/{card_contract_id}/pins/verifications"),
    (HttpMethod.Post, "/cards/{card_contract_id}/card-verification-codes/searches"),
