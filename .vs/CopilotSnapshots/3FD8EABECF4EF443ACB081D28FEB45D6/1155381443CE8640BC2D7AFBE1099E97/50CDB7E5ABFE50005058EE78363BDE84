    }

    public async Task<JsonElement?> SendAsync(
        HttpMethod method, string relativePathAndQuery, JsonElement? body = null, CancellationToken cancellationToken = default)
    {
        using var request = new HttpRequestMessage(method, relativePathAndQuery);
        if (body is not null)
        {
            request.Content = new StringContent(body.Value.GetRawText(), System.Text.Encoding.UTF8, "application/json");
        }

        using var response = await _httpClient.SendAsync(request, cancellationToken);
        if (!response.IsSuccessStatusCode)
        {
            var errorBody = await response.Content.ReadAsStringAsync(cancellationToken);
            throw new MastercardApiException((int)response.StatusCode, errorBody);
        }

        if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
        {
            return null;
        }

        var text = await response.Content.ReadAsStringAsync(cancellationToken);
        return string.IsNullOrWhiteSpace(text) ? null : JsonDocument.Parse(text).RootElement.Clone();
    }

    private async Task<JsonElement?> SendAsync(
        HttpMethod method, string path, JsonElement? body, IEnumerable<(string Key, string? Value)>? query,
        IEnumerable<(string Name, string? Value)>? headers, CancellationToken cancellationToken)
    {
        var uri = BuildUri(path, query);
        using var request = new HttpRequestMessage(method, uri);
        if (body is not null)
        {
            request.Content = new StringContent(body.Value.GetRawText(), System.Text.Encoding.UTF8, "application/json");
        }

        if (headers is not null)
        {
            foreach (var (name, value) in headers)
            {
                if (!string.IsNullOrEmpty(value))
                {
                    request.Headers.TryAddWithoutValidation(name, value);
                }
            }
        }

        using var response = await _httpClient.SendAsync(request, cancellationToken);
        if (!response.IsSuccessStatusCode)
        {
            var errorBody = await response.Content.ReadAsStringAsync(cancellationToken);
            throw new MastercardApiException((int)response.StatusCode, errorBody);
        }

        if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
        {
            return null;
        }

        var text = await response.Content.ReadAsStringAsync(cancellationToken);
        return string.IsNullOrWhiteSpace(text) ? null : JsonDocument.Parse(text).RootElement.Clone();
    }

    private static string BuildUri(string path, IEnumerable<(string Key, string? Value)>? query)
    {
        if (query is null)
        {
            return path;
        }

        var parts = query
            .Where(q => q.Value is not null)
            .Select(q => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(q.Value!)}")
            .ToList();

        return parts.Count == 0 ? path : $"{path}?{string.Join('&', parts)}";
    }

    private static IEnumerable<(string Name, string? Value)> IdempotencyHeader(string? idempotencyKey) =>
